# Copy to .env and fill in from: Supabase Dashboard → Project Settings → API
# NOTE: service-role key NEVER touches client code; it is used only by this
# local test harness to create/teardown fixture accounts.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY